{
  "_repoIdentifier": "talaria",
  "name": "talaria",
  "version": 1,
  "container": {
    "port": 8321,
    "auto_port": true,
    "podman_args": "--memory 2g",
    "env": {
      "HOST": "0.0.0.0",
      "PORT": "8321",
      "TALARIA_DOMAIN": "talaria.ffilt.us",
      "HERMES_API_URL": "http://host.containers.internal:8642",
      "HERMES_API_KEY": "{SECRETS.HERMES_API_KEY}",
      "STT_MODEL": "base",
      "LOG_LEVEL": "info",
      "HF_HOME": "/app/cache"
    },
    "volumes": [
      "talaria-cache:/app/cache"
    ],
    "healthCheck": {
      "path": "/health",
      "timeout": 15000
    }
  },
  "expose": {
    "enabled": true,
    "hostname": "talaria.ffilt.us",
    "tunnel": "ca308a1b-557a-4a18-9350-6eec27465bdf"
  },
  "strategy": {
    "type": "blue-green",
    "queue": true
  },
  "build": {
    "network": "host",
    "podman_args": "--memory 2g"
  },
  "logo": {
    "_type": "url",
    "url": "https://cdn.jsdelivr.net/npm/heroicons@2/outline/microphone.svg"
  },
  "rateLimit": {
    "requestsPerMinute": 120,
    "blockDurationMs": 300000
  },
  "apkBuild": {
    "packageName": "com.reedsutliff.talaria",
    "type": "kotlin",
    "path": "android",
    "task": "assembleDebug",
    "buildType": "debug",
    "destDir": "Talaria",
    "extraProps": {
      "talariaWsUrl": "wss://talaria.ffilt.us/v1/ptt"
    }
  }
}
 
